    <string name="microg_title">Google服务</string>
    <string name="setup_euicc">设置 eSIM</string>
    <string name="euicc_summary">您还可以将 eSIM 添加到您的设备。</string>
    <string name="bootloader_warning_summary">该设备的 Bootloader 目前是解锁的。请从计算机锁定它。访问 <a href="https://calyxos.org/lock">calyxos.org/lock</a>获取更多信息。</string>
    <string name="reboot">重启</string>
    <string name="bootloader_warning_title">Bootloader 锁定警告</string>
    <string name="microg_switch_label2">Google 服务兼容性</string>
    <string name="microg_defaults_switch_label">推送通知支持</string>
    <string name="microg_description2">microG 是 <b>Google Play Services</b>; (以及相关软件) 的开源替代，只包含有用部分。 和 Play Services 不同，microG 不含任何广告或位置跟踪。</string>
    <string name="microg_defaults_summary">允许应用注册 Google 推送通知。这会将你的设备注册到 Google 服务，不包含特定于设备的唯一标识符。可以稍后在 microG 设置中启用它，但是之前安装的任何应用都需要重新安装才能正常工作。</string>
    <string name="microg_location_switch_label">网络位置</string>
    <string name="microg_summary">这允许<b>Google Maps、YouTube 和拼车服务</b>等应用运行。如果你不打算在你的 <xliff:g id="profileType" example="personal profile">%1$s</xliff:g> 配置中运行需要 Google services 的应用，请停用此设置。此设置之后无法更改。</string>
    <string name="managed_profile">工作配置</string>
    <string name="personal_profile">个人配置</string>
    <string name="microg_online_source_positon_title">位置（建议）</string>
    <string name="microg_online_source_beacondb_title">BeaconDB</string>
    <string name="microg_online_source_beacondb_summary">beacondb.net - 访问站点了解详情</string>
    <string name="microg_online_source_none_title">无</string>
    <string name="microg_online_source_positon_summary">positon.xyz - 访问站点了解详情</string>
    <string name="microg_online_source_none_summary">不使用附近 Wi-FI 和信号网络进行在线位置查找。</string>
    <string name="microg_online_source_select_summary">请选择一个线上源：</string>
    <string name="microg_online_source_required_error">请选择一个线上源，或者不选。</string>
    <string name="microg_location_summary2">改进位置服务，手段包括查询带附近 Wi-Fi 和信号网络的选定服务，使用 Nominatim 查找地址，记住附近网络的 GPS 坐标等。你可以稍后在 microG 设置中更精细地自定义这些选项。</string>
